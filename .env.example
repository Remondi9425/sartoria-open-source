# Template for shell/deployment configuration; Python does not auto-load this file.
# Export the values in your shell or configure them on your hosting platform.
SARTORIA_ENV=production
SARTORIA_TOKEN_SECRET=""
SARTORIA_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
SARTORIA_VERCEL_PROJECT=
SARTORIA_REGION=eu
SARTORIA_MIN_CONTAINERS=0
SARTORIA_SCALEDOWN_S=900
# Only for isolated local development, never a public deployment:
SARTORIA_ALLOW_INSECURE_DEV=0
SARTORIA_DEBUG_ENDPOINT=0
